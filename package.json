{
  "name": "jsonl-viewer",
  "displayName": "JSONL Viewer",
  "description": "A fast, read-only tree viewer for JSON, JSONL, and NDJSON files.",
  "version": "0.1.0",
  "publisher": "ZYseven",
  "license": "MIT",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": ["Visualization", "Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "jsonlViewer.viewer",
        "displayName": "JSONL Viewer",
        "selector": [
          { "filenamePattern": "*.json" },
          { "filenamePattern": "*.jsonl" },
          { "filenamePattern": "*.ndjson" }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "check": "tsc --noEmit",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "test": "npm run check && npm run test:compile && node --test dist-test/test/**/*.test.js",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.92.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
